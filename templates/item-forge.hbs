<div class="rb-forge-root">
  <div class="rb-forge-scroll">
  <section class="rb-block rb-forge-head">
    <span class="rb-forge-imgwrap" data-action="pickIcon">
      <img class="rb-forge-img" src="{{st.img}}" alt="">
      <span class="rb-forge-replace">{{rbL "WFRPRB.Forge.Replace"}}</span>
    </span>
    <div class="rb-forge-headfields">
      <input type="text" class="rb-forge-name" value="{{st.name}}" placeholder="{{rbL 'WFRPRB.Forge.Name'}}...">
      <div class="rb-field"><label>{{rbL "WFRPRB.Forge.Weight"}}</label>
        <input type="number" class="rb-num rb-forge-enc" value="{{st.enc}}" min="0" step="1"></div>
      <div class="rb-field"><label>{{rbL "WFRPRB.Forge.Price"}}</label>
        <span class="rb-money-fields">
          <label class="rb-coinfield">{{{coinGc}}}<input type="number" class="rb-num rb-forge-gc" value="{{st.priceGc}}" min="0"></label>
          <label class="rb-coinfield">{{{coinSs}}}<input type="number" class="rb-num rb-forge-ss" value="{{st.priceSs}}" min="0"></label>
          <label class="rb-coinfield">{{{coinBp}}}<input type="number" class="rb-num rb-forge-pbp" value="{{st.priceBp}}" min="0"></label>
        </span></div>
      <div class="rb-field"><label>{{rbL "WFRPRB.Forge.Type"}}</label>
        <select class="rb-forge-type">{{#each types}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
      {{#if isTrapping}}
        <div class="rb-field"><label>{{rbL "WFRPRB.Forge.SubType"}}</label>
          <select class="rb-forge-subtype">{{#each trappingTypes}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
      {{/if}}
    </div>
  </section>

  <nav class="rb-tabs">
    <button type="button" class="rb-tab {{#if (eq st.tab 'qualities')}}is-active{{/if}}" data-action="selectTab" data-tab="qualities">
      {{rbL "WFRPRB.Forge.Qualities"}}{{#if counts.q}}<span class="rb-tab-count">{{counts.q}}</span>{{/if}}</button>
    <button type="button" class="rb-tab {{#if (eq st.tab 'flaws')}}is-active{{/if}}" data-action="selectTab" data-tab="flaws">
      {{rbL "WFRPRB.Forge.Flaws"}}{{#if counts.f}}<span class="rb-tab-count">{{counts.f}}</span>{{/if}}</button>
    <button type="button" class="rb-tab {{#if (eq st.tab 'crit')}}is-active{{/if}}" data-action="selectTab" data-tab="crit">
      {{rbL "WFRPRB.Forge.TabCrit"}}{{#if counts.c}}<span class="rb-tab-count">{{counts.c}}</span>{{/if}}</button>
    <button type="button" class="rb-tab {{#if (eq st.tab 'fail')}}is-active{{/if}}" data-action="selectTab" data-tab="fail">
      {{rbL "WFRPRB.Forge.TabFail"}}{{#if counts.x}}<span class="rb-tab-count">{{counts.x}}</span>{{/if}}</button>
  </nav>

  {{#if (eq st.tab "qualities")}}
  <section class="rb-block">
    {{#each qRows}}
      <div class="rb-row rb-qrow" data-key="{{key}}" {{#if tip}}data-rb-tip="{{tip}}"{{/if}}>
        <label class="rb-ing-name"><input type="checkbox" class="rb-prop-on" {{#if on}}checked{{/if}}><span class="rb-prop-label">{{label}}</span></label>
          {{#if hasValue}}<input type="number" class="rb-num rb-num--s rb-prop-value" value="{{value}}" min="1" aria-label="{{rbL 'WFRPRB.A11y.PropLevel'}}" data-rb-tip="{{rbL 'WFRPRB.A11y.PropLevel'}}">{{/if}}
        {{#if on}}
          <span class="rb-forge-extra">
            <button type="button" class="rb-btn rb-btn--quiet rb-extra-pick" data-action="pickExtra">
              {{#if extraImg}}<img src="{{extraImg}}" alt="">{{/if}}{{#if extraName}}{{extraName}}{{else}}+ {{rbL "WFRPRB.Forge.AddIngredient"}}{{/if}}
            </button>
            {{#if extraName}}×&nbsp;<input type="number" class="rb-num rb-num--s rb-extra-count" value="{{extraCount}}" min="1">{{/if}}
            <label class="rb-coinfield"><i class="rb-coin-dot rb-coin-dot--bp"></i><input type="number" class="rb-num rb-extra-bp" value="{{extraBp}}" min="0" data-rb-tip="{{rbL 'WFRPRB.Forge.Money'}}"></label>
          </span>
        {{/if}}
      </div>
    {{/each}}
  </section>
  {{/if}}

  {{#if (eq st.tab "flaws")}}
  <section class="rb-block">
    {{#each fRows}}
      <div class="rb-row rb-frow" data-key="{{key}}" {{#if tip}}data-rb-tip="{{tip}}"{{/if}}>
        <label class="rb-ing-name"><input type="checkbox" class="rb-prop-on" {{#if on}}checked{{/if}}><span class="rb-prop-label">{{label}}</span></label>
          {{#if hasValue}}<input type="number" class="rb-num rb-num--s rb-prop-value" value="{{value}}" min="1" aria-label="{{rbL 'WFRPRB.A11y.PropLevel'}}" data-rb-tip="{{rbL 'WFRPRB.A11y.PropLevel'}}">{{/if}}
      </div>
    {{/each}}
  </section>
  {{/if}}

  {{#if (eq st.tab "crit")}}
  <section class="rb-block">
    <div class="rb-dim rb-forge-tabnote">{{rbL "WFRPRB.Forge.CritNote"}}</div>
    <div class="rb-field"><label>{{rbL "WFRPRB.Crit.Threshold"}}</label>
      <input type="number" class="rb-num rb-forge-critsl" value="{{st.critSL}}" min="1"></div>
    {{#each critRows}}
      <div class="rb-row rb-critrow" data-key="{{key}}" {{#if tip}}data-rb-tip="{{tip}}"{{/if}}>
        <label class="rb-ing-name"><input type="checkbox" class="rb-prop-on" {{#if on}}checked{{/if}}><span class="rb-prop-label">{{label}}</span></label>
          {{#if hasValue}}<input type="number" class="rb-num rb-num--s rb-prop-value" value="{{value}}" min="1" aria-label="{{rbL 'WFRPRB.A11y.PropLevel'}}" data-rb-tip="{{rbL 'WFRPRB.A11y.PropLevel'}}">{{/if}}
      </div>
    {{/each}}
    {{#if critMulti}}
      <div class="rb-field"><label>{{rbL "WFRPRB.Forge.QualMode"}}</label>
        <select class="rb-forge-critmode">
          <option value="and" {{#if (eq st.critMode "and")}}selected{{/if}}>{{rbL "WFRPRB.Forge.ModeAnd"}}</option>
          <option value="or" {{#if (eq st.critMode "or")}}selected{{/if}}>{{rbL "WFRPRB.Forge.ModeOr"}}</option>
        </select></div>
    {{/if}}
  </section>
  {{/if}}

  {{#if (eq st.tab "fail")}}
  <section class="rb-block">
    <div class="rb-dim rb-forge-tabnote">{{rbL "WFRPRB.Forge.FailNote"}}</div>
    <label class="rb-field rb-field-check"><span>{{rbL "WFRPRB.Forge.FailFlawed"}}</span>
      <input type="checkbox" class="rb-forge-failflawed" {{#if st.failFlawed}}checked{{/if}}></label>
    <div class="rb-field"><label>{{rbL "WFRPRB.Forge.CleanSL"}}</label>
      <input type="number" class="rb-num rb-forge-cleansl" value="{{st.cleanSL}}" min="0" data-rb-tip="{{rbL 'WFRPRB.Forge.CleanSLOff'}}"></div>
    {{#if (or st.failFlawed st.cleanSL)}}
      <div class="rb-dim rb-forge-poollabel">{{rbL "WFRPRB.Forge.FailPool"}}:</div>
      {{#each poolRows}}
        <div class="rb-row rb-poolrow" data-key="{{key}}" {{#if tip}}data-rb-tip="{{tip}}"{{/if}}>
          <label class="rb-ing-name"><input type="checkbox" class="rb-prop-on" {{#if on}}checked{{/if}}><span class="rb-prop-label">{{label}}</span></label>
        </div>
      {{/each}}
    {{/if}}
  </section>
  {{/if}}
  </div>

  <footer class="rb-sheet-foot">
    <span class="rb-forge-prognosis" data-rb-tip="{{rbL 'WFRPRB.Forge.PrognosisTip'}}">
      {{rbL "WFRPRB.Forge.Prognosis"}}: <b>{{prognosis}}</b> <span class="rb-dim">({{rbL "WFRPRB.SLTarget"}}: {{baseSL}})</span>
    </span>
    <span class="rb-sheet-foot-gap"></span>
    <button type="button" class="rb-btn rb-btn--primary" data-action="forgeCreate">{{rbL "WFRPRB.Forge.Create"}}</button>
  </footer>
</div>
